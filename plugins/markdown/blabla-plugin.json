{
  "apiVersion": 1,
  "id": "markdown",
  "name": "markdown",
  "version": "0.1.3",
  "minAppVersion": "0.1.16",
  "description": "Blabla Markdown editor plugin backed by host-owned source text documents.",
  "author": {
    "name": "Blabla"
  },
  "runtime": "local-web",
  "activation": {
    "events": [
      "onSurface:markdown",
      "onBackgroundService:markdown-background"
    ]
  },
  "permissions": {
    "documentMetadata": [
      "title:write"
    ],
    "fileReferences": [
      "import",
      "read",
      "watch"
    ],
    "imageExports": [
      "clipboard",
      "save"
    ],
    "navigation": [
      "open"
    ],
    "settings": [
      "read",
      "write"
    ],
    "sourceText": [
      "read",
      "recovery",
      "write"
    ],
    "surface": [
      "dirty"
    ]
  },
  "contributes": {
    "backgroundServices": [
      {
        "entry": "./scripts/markdown-background.mjs",
        "id": "markdown-background",
        "idleTtlMs": 300000
      }
    ],
    "derivativeProviders": [
      {
        "id": "markdown-cover",
        "serviceId": "markdown-background",
        "roles": [
          "thumbnail",
          "preview"
        ],
        "input": "sourceText",
        "mimeTypes": [
          "text/markdown"
        ],
        "extensions": [
          ".md",
          ".markdown"
        ],
        "outputMime": "image/svg+xml",
        "timeoutMs": 5000,
        "priority": 40
      }
    ],
    "fileHandlers": [
      {
        "id": "markdown-document",
        "surfaceId": "markdown",
        "actions": [
          "create",
          "open",
          "edit"
        ],
        "documentStorage": "sourceText",
        "extensions": [
          ".md",
          ".markdown"
        ],
        "mimeTypes": [
          "text/markdown"
        ],
        "priority": 40
      }
    ],
    "surfaces": [
      {
        "id": "markdown",
        "documentType": "markdown",
        "background": "host-material",
        "hostUi": {
          "newToolbar": {
            "tooltip": "Create Markdown"
          }
        },
        "runtime": "webcontents",
        "staticRoot": "./dist",
        "url": "http://127.0.0.1:{port}/"
      }
    ]
  },
  "interface": {
    "displayName": "Markdown",
    "logo": "./assets/logo.svg",
    "shortDescription": "Source-backed Markdown editor.",
    "longDescription": "A local Tiptap 3 Markdown editor that uses Host API v1 sourceText documents for asset-backed reads, conflict-aware writes, dirty state, and title updates.",
    "developerName": "Blabla",
    "category": "Productivity",
    "capabilities": [
      "Markdown",
      "Write"
    ],
    "defaultPrompt": [
      "Open the Markdown plugin."
    ]
  }
}
